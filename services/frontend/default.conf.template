# Rendered by the nginx image at start (envsubst of BACKEND_URL, VISION_URL).

# WebSocket (/vision/camera): pass the Upgrade handshake through; plain requests keep a normal connection
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # Upstreams in variables + Docker DNS: resolved per request, so nginx still starts when the vision service is
    # not running (it is optional, e.g. run natively on Windows for webcam access).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $backend ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        client_max_body_size 20m;  # results carry a JPEG
    }

    location /vision/ {
        set $vision ${VISION_URL};
        rewrite ^/vision/(.*)$ /$1 break;
        proxy_pass $vision;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;      # MJPEG: pass each frame through at once
        proxy_read_timeout 1h;
    }
}
