# Copy to .env and fill in. Read by docker compose and by services run natively.

# --- docker compose ---
POSTGRES_PASSWORD=change-me
FRONTEND_PORT=8080
# Where the frontend finds the vision service:
#   vision in Docker (--profile vision): http://vision:8090
#   vision run natively on this machine:  http://host.docker.internal:8090
VISION_URL=http://host.docker.internal:8090
# Camera for the vision container: browser (the web page sends its webcam, asks for camera permission),
# a stream URL (rtsp://user:pass@ip/stream), or 0 on Linux with /dev/video0
CAMERA_SOURCE_DOCKER=browser

# --- vision run natively (cd services/vision && uv run python -m vision) ---
CAMERA_SOURCE=0
BE_URL=http://localhost:8080/api

# --- backend run natively (cd services/backend && uv run uvicorn app.server:app --port 8001) ---
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/barcode_cv
